# ── HollowLink backend ─────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# HTTP + WebSocket port
PORT=8787

# Comma-separated list of allowed browser origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# Path to the SQLite database file (relative to backend/, or absolute)
DATABASE_PATH=../database/hollowlink.db

# Directory where uploaded media is stored (relative to backend/, or absolute)
UPLOAD_DIR=../uploads

# 64+ random hex chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_64_plus_random_hex_characters
JWT_EXPIRES_IN=7d

# Public base URL of the web app (used in emails / links)
APP_URL=http://localhost:5173

# How long password-reset tokens are valid (e.g. 1h)
PASSWORD_RESET_TTL=1h

# Invite-only registration (optional). Set a code here and share it privately with
# the friends you want to join — anyone without it cannot create an account.
# Leave unset/empty for open registration.
# Example: REGISTRATION_INVITE_CODE=our-special-link-code-2026
REGISTRATION_INVITE_CODE=
